# Exercise the benchmark CLI contract (including machine-readable standard output).
cmake_minimum_required(VERSION 3.30)
set(workers 1)
set(variant_count 3)
if(THREADED)
    set(workers 1,2)
    set(variant_count 6)
endif()
set(csv "${CMAKE_CURRENT_BINARY_DIR}/headless-${MODE}.csv")
execute_process(COMMAND "${CLI}" --mode "${MODE}" --workers "${workers}" --scenario dense --seed 42
    --bodies 24 --warmup 1 --steps 3 --repetitions 2 --response detection-only --json - --csv "${csv}"
    OUTPUT_VARIABLE output ERROR_VARIABLE log COMMAND_ERROR_IS_FATAL ANY)

function(expect wanted)
    string(JSON actual GET "${output}" ${ARGN})
    if(NOT "${actual}" STREQUAL "${wanted}")
        message(FATAL_ERROR "${ARGN}: expected '${wanted}', got '${actual}'")
    endif()
endfunction()

expect(1 schema_version)
expect(2 protocol first_measured_tick)
string(JSON actual_count LENGTH "${output}" cases 0 variants)
if(NOT actual_count EQUAL variant_count)
    message(FATAL_ERROR "Expected ${variant_count} variants, found ${actual_count}")
endif()
math(EXPR last "${variant_count} - 1")
foreach(i RANGE 0 ${last})
    set(v cases 0 variants ${i})
    expect(passed ${v} validation)
    expect(complete ${v} status)
    foreach(r RANGE 0 1)
        set(run ${v} runs ${r})
        math(EXPR order "(${i} - ${r} + ${variant_count}) % ${variant_count} + 1")
        expect(${order} ${run} order)
        string(JSON length LENGTH "${output}" ${run} samples)
        if(NOT length EQUAL 3)
            message(FATAL_ERROR "Wrong number of measured ticks")
        endif()
        foreach(s RANGE 0 2)
            math(EXPR tick "${s} + 2")
            set(sample ${run} samples ${s})
            expect(${tick} ${sample} tick)
            string(JSON contacts GET "${output}" cases 0 variants 0 runs 0 samples ${s} contacts)
            if(contacts LESS 1)
                message(FATAL_ERROR "Dense fixture must exercise contact validation")
            endif()
            expect(${contacts} ${sample} contacts)
            if(i EQUAL 0)
                expect(276 ${sample} pairs_examined)
            endif()
            string(JSON timing_type TYPE "${output}" ${sample} total_step_s)
            if((MODE STREQUAL "replay" AND NOT timing_type STREQUAL "NULL") OR
               (MODE STREQUAL "simulation" AND NOT timing_type STREQUAL "NUMBER"))
                message(FATAL_ERROR "Wrong timing scope in ${MODE}")
            endif()
        endforeach()
    endforeach()
endforeach()
file(STRINGS "${csv}" rows)
list(LENGTH rows row_count)
math(EXPR expected_rows "1 + 6 * ${variant_count}")
if(NOT row_count EQUAL expected_rows)
    message(FATAL_ERROR "Expected ${expected_rows} CSV lines, got ${row_count}")
endif()

execute_process(COMMAND "${CLI}" --mode "${MODE}" --help OUTPUT_VARIABLE help COMMAND_ERROR_IS_FATAL ANY)
if(NOT help MATCHES "--algorithm" OR NOT help MATCHES "--no-validate")
    message(FATAL_ERROR "Missing benchmark options in CLI help")
endif()

execute_process(COMMAND "${CLI}" --warmup=008 --steps=1 --repetitions=1 --algorithm=kd-tree,sweep-and-prune
    --mode "${MODE}" --seed=0010 --bodies 0 --no-validate --json - OUTPUT_VARIABLE output ERROR_QUIET COMMAND_ERROR_IS_FATAL ANY)
set(v cases 0 variants 0)
expect(9 protocol first_measured_tick)
expect(10 cases 0 seed)
expect(kd-tree ${v} algorithm)
expect(sweep-and-prune cases 0 variants 1 algorithm)
expect(skipped ${v} validation)
expect("" ${v} summary speedup_vs_brute_force)
expect("" ${v} runs 0 samples 0 candidate_reduction)
expect("" ${v} runs 0 samples 0 false_positive_fraction)

foreach(args "--steps;0" "--seed;-1" "--fixed-step;nan" "--workers;0" "--algorithm;other"
             "--repetitions;1x" "--json;${csv};--csv;${csv}" "--bodies;4;--debris;2"
             "--seed;1,,2" "--workers;1,1" "--unknown-flag")
    execute_process(COMMAND "${CLI}" ${args} OUTPUT_QUIET ERROR_QUIET RESULT_VARIABLE status)
    if(status EQUAL 0)
        message(FATAL_ERROR "Unexpected success for ${args}")
    endif()
endforeach()

if(NOT THREADED)
    execute_process(COMMAND "${CLI}" --algorithm kd-tree --workers 1,2 --steps 1 --warmup 0
        --repetitions 1 --bodies 0 --mode "${MODE}" --json - RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_QUIET)
    if(status EQUAL 0)
        message(FATAL_ERROR "A sequential build accepted two workers")
    endif()
    expect(complete cases 0 variants 0 status)
    expect(failed cases 0 variants 1 status)
    expect("" cases 0 variants 1 summary)
endif()
